# /etc/scamread.env  (chmod 600, owned by root)
SCAMREAD_ENV=production
SCAMREAD_DATABASE_PATH=/opt/scamread/data/scamread.db
# Long random value. Leave empty to switch admin endpoints off.
SCAMREAD_ADMIN_TOKEN=
# Folder with private pattern packs (*.json), kept outside git.
SCAMREAD_PRIVATE_PATTERNS_DIR=/opt/scamread/data/private-patterns
# Optional tuning
SCAMREAD_CACHE_TTL_SECONDS=900
SCAMREAD_CACHE_MAX_ENTRIES=5000
SCAMREAD_RECORD_MIN_RISK_SCORE=40
